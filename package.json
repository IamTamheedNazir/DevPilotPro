{
  "name": "specforge",
  "version": "1.0.0",
  "description": "Turn specs into full projects with coding agents. More powerful than spec-kit.",
  "type": "module",
  "bin": {
    "specforge": "./bin/specforge.js"
  },
  "main": "./dist/cli/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli/index.ts",
    "start": "node dist/cli/index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "node --test src/**/*.test.ts"
  },
  "keywords": [
    "spec",
    "specification",
    "code-generation",
    "coding-agent",
    "claude-code",
    "codex",
    "cursor",
    "windsurf",
    "vibe-coding",
    "developer-tools",
    "cli"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@octokit/rest": "^21.0.0",
    "chalk": "^4.1.2",
    "commander": "^12.0.0",
    "glob": "^10.0.0",
    "inquirer": "^8.0.0",
    "js-yaml": "^4.1.0",
    "simple-git": "^3.0.0"
  },
  "devDependencies": {
    "@types/glob": "^8.0.0",
    "@types/inquirer": "^8.0.0",
    "@types/js-yaml": "^4.0.0",
    "@types/node": "^24.10.1",
    "tsx": "^4.0.0",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
